  <diagram name="19 · ERD — SUBSCRIPTION &amp; PAYMENT" id="q4DrBpTXr7B6a2GsuE7I">
    <mxGraphModel dx="1341" dy="879" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2560" pageHeight="1892" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
