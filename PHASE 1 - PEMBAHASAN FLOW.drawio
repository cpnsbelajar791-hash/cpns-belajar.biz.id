        <mxCell id="guide-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#0F172A;" value="CPNS MASTERY — UML &amp; SYSTEM ANALYSIS v1.0" vertex="1">
