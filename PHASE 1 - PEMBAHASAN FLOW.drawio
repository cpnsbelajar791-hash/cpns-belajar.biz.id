        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam actorBorderColor #0F172A\nskinparam actorFontColor #0F172A\nskinparam usecaseBackgroundColor #EFF6FF\nskinparam usecaseBorderColor #2563EB\nskinparam usecaseFontColor #0F172A\nskinparam rectangleBackgroundColor #F8FAFC\nskinparam rectangleBorderColor #94A3B8\nskinparam rectangleFontColor #334155\nskinparam packageStyle rectangle\ntitle CPNS Mastery \u2014 Learner Use Cases\nleft to right direction\nactor Guest\nactor Learner\nactor \&quot;Premium Member\&quot; as Premium\nPremium --|&gt; Learner\n\nrectangle \&quot;CPNS Mastery \u2014 Learner Experience\&quot; {\n  package \&quot;Account &amp; Onboarding\&quot; {\n    usecase \&quot;Register Account\&quot; as UC_REGISTER\n    usecase \&quot;Login / Reset Password\&quot; as UC_LOGIN\n    usecase \&quot;Complete Onboarding\&quot; as UC_ONBOARD\n  }\n  package \&quot;Learning\&quot; {\n    usecase \&quot;View Learning Roadmap\&quot; as UC_ROADMAP\n    usecase \&quot;Read Material\&quot; as UC_MATERIAL\n    usecase \&quot;Bookmark / Mark Complete\&quot; as UC_BOOKMARK\n  }\n  package \&quot;Practice &amp; Assessment\&quot; {\n    usecase \&quot;Practice Questions\&quot; as UC_PRACTICE\n    usecase \&quot;Check Answer &amp; Explanation\&quot; as UC_FEEDBACK\n    usecase \&quot;Run Timed Tryout\&quot; as UC_TRYOUT\n    usecase \&quot;Autosave Answers\&quot; as UC_AUTOSAVE\n    usecase \&quot;Submit / Auto-submit\&quot; as UC_SUBMIT\n    usecase \&quot;View Score &amp; Competency\\nAnalysis\&quot; as UC_RESULT\n    usecase \&quot;Review Wrong Answers\&quot; as UC_REMEDIATE\n  }\n  package \&quot;Membership\&quot; {\n    usecase \&quot;View Plans &amp; Checkout\&quot; as UC_CHECKOUT\n    usecase \&quot;View Subscription Status\&quot; as UC_SUBSCRIPTION\n  }\n}\n\nGuest --&gt; UC_REGISTER\nGuest --&gt; UC_LOGIN\nLearner --&gt; UC_ONBOARD\nLearner --&gt; UC_ROADMAP\nLearner --&gt; UC_MATERIAL\nLearner --&gt; UC_PRACTICE\nLearner --&gt; UC_CHECKOUT\nLearner --&gt; UC_SUBSCRIPTION\nPremium --&gt; UC_TRYOUT\nPremium --&gt; UC_RESULT\nPremium --&gt; UC_REMEDIATE\n\nUC_MATERIAL ..&gt; UC_BOOKMARK : &lt;&lt;extend&gt;&gt;\nUC_PRACTICE ..&gt; UC_FEEDBACK : &lt;&lt;include&gt;&gt;\nUC_TRYOUT ..&gt; UC_AUTOSAVE : &lt;&lt;include&gt;&gt;\nUC_TRYOUT ..&gt; UC_SUBMIT : &lt;&lt;include&gt;&gt;\nUC_SUBMIT ..&gt; UC_RESULT : &lt;&lt;include&gt;&gt;\nUC_RESULT ..&gt; UC_REMEDIATE : &lt;&lt;extend&gt;&gt;\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="preserve" svgContentWidth="1650" svgContentHeight="1050" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="usecase-wrap-28" fontPolicy="SansSerif-portable" renderPolicy="source-first-wrap;svg-aspect-preserved" id="g-02-df613aadca">
