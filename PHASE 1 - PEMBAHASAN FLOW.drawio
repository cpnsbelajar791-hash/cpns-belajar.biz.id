        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nskinparam wrapWidth 180\n&lt;style&gt;\nActivityDiagram {\n  MaximumWidth 240\n}\n&lt;/style&gt;\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam activityBackgroundColor #EFF6FF\nskinparam activityBorderColor #2563EB\nskinparam activityFontColor #0F172A\nskinparam activityDiamondBackgroundColor #FFF7ED\nskinparam activityDiamondBorderColor #F97316\nskinparam activityStartColor #16A34A\nskinparam activityEndColor #DC2626\nskinparam partitionBackgroundColor #F8FAFC\nskinparam partitionBorderColor #CBD5E1\nskinparam partitionFontColor #334155\ntitle Activity — Wrong-answer Review and Remediation\n|Learner|\nstart\n:Open wrong-answer queue;\n|Progress Service|\n:Load unresolved items ordered\\nby priority;\n|Content Service|\n:Load current explanation and\\nlinked material;\n|Web App|\n:Show question, previous\\nresponse, explanation, and\\nconcept link;\n|Learner|\nif (Review material first?) then (yes)\n  :Open linked material section;\n  :Return to remediation item;\nendif\n:Retry question;\n|Assessment Service|\n:Evaluate retry and save\\nevidence;\n|Progress Service|\nif (Retry correct?) then (yes)\n  :Increase mastery confidence;\n  if (Resolution threshold\\nreached?) then (yes)\n    :Mark remediation item resolved;\n  else (no)\n    :Schedule spaced repetition;\n  endif\nelse (no)\n  :Keep item active and raise\\npriority;\n  :Recommend prerequisite\\nmaterial;\nendif\n|Web App|\n:Show updated mastery and next\\nreview date;\nstop\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1100" svgContentHeight="1450" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="activity-wrap-30" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-09-1a36304264">
