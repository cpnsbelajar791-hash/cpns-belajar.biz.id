        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam componentBackgroundColor #EFF6FF\nskinparam componentBorderColor #2563EB\nskinparam componentFontColor #0F172A\nskinparam nodeBackgroundColor #F8FAFC\nskinparam nodeBorderColor #64748B\nskinparam nodeFontColor #0F172A\nskinparam databaseBackgroundColor #ECFDF5\nskinparam databaseBorderColor #16A34A\nskinparam databaseFontColor #064E3B\nskinparam cloudBackgroundColor #FFF7ED\nskinparam cloudBorderColor #F97316\nskinparam queueBackgroundColor #F5F3FF\nskinparam queueBorderColor #7C3AED\nskinparam queueFontColor #4C1D95\nskinparam linetype ortho\ntitle CPNS Mastery \u2014 Logical Component Architecture\nleft to right direction\npackage \&quot;Client Layer \u2014 Firebase App Hosting\&quot; {\n  [Learner Web App] as LearnerWeb\n  [Admin CMS Web App] as AdminWeb\n}\npackage \&quot;API &amp; Domain Services \u2014 Horizontal Autoscaling\&quot; {\n  [API Gateway / BFF] as BFF\n  [Identity Service] as Identity\n  [Content Service] as Content\n  [Assessment Service] as Assessment\n  [Scoring Service] as Scoring\n  [Progress Service] as Progress\n  [Billing Service] as Billing\n  [Notification Service] as Notify\n  [Audit Service] as Audit\n}\ndatabase \&quot;Neon PostgreSQL\&quot; as DB\nqueue \&quot;Kafka\&quot; as Queue\ncloud \&quot;Firebase Storage\&quot; as Storage\ncloud \&quot;Xendit\\nPayment Gateway\&quot; as Gateway\ncloud \&quot;Resend\\nEmail Provider\&quot; as Email\n\nLearnerWeb --&gt; BFF : HTTPS / JSON\nAdminWeb --&gt; BFF : HTTPS / JSON\nBFF --&gt; Identity\nBFF --&gt; Content\nBFF --&gt; Assessment\nBFF --&gt; Progress\nBFF --&gt; Billing\nAssessment --&gt; Scoring\nContent --&gt; Storage\nAssessment --&gt; Storage\nIdentity --&gt; DB\nContent --&gt; DB\nAssessment --&gt; DB\nScoring --&gt; DB\nProgress --&gt; DB\nBilling --&gt; DB\nAudit --&gt; DB\nAssessment --&gt; Queue : scoring / progress events\nContent --&gt; Queue : publish events\nBilling --&gt; Queue : payment events\nQueue --&gt; Progress\nQueue --&gt; Notify\nQueue --&gt; Audit\nBilling --&gt; Gateway\nNotify --&gt; Email\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1600" svgContentHeight="1050" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="portable-font-only" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-20-a48d608d29">
