        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam actorBorderColor #0F172A\nskinparam actorFontColor #0F172A\nskinparam usecaseBackgroundColor #EFF6FF\nskinparam usecaseBorderColor #2563EB\nskinparam usecaseFontColor #0F172A\nskinparam rectangleBackgroundColor #F8FAFC\nskinparam rectangleBorderColor #94A3B8\nskinparam rectangleFontColor #334155\nskinparam packageStyle rectangle\ntitle CPNS Mastery — Content Management Use Cases\nleft to right direction\nactor \&quot;Content Admin\&quot; as Author\nactor Reviewer\nactor \&quot;Super Admin\&quot; as Admin\n\nrectangle \&quot;Content Management System\&quot; {\n  package \&quot;Authoring\&quot; {\n    usecase \&quot;Create / Edit Material\&quot; as UC_MATERIAL\n    usecase \&quot;Create / Edit Question\&quot; as UC_QUESTION\n    usecase \&quot;Assign Content Taxonomy\&quot; as UC_TAXONOMY\n    usecase \&quot;Link Related Material\\n(optional)\&quot; as UC_RELATED\n    usecase \&quot;Upload Figural / Supporting\\nAsset\&quot; as UC_ASSET\n    usecase \&quot;Define Source Rights\&quot; as UC_RIGHTS\n    usecase \&quot;Configure Answer &amp; Scoring\&quot; as UC_SCORING\n    usecase \&quot;Preview Learner Rendering\&quot; as UC_PREVIEW\n    usecase \&quot;Create / Edit Practice or\\nTryout Package\&quot; as UC_PACKAGE\n    usecase \&quot;Configure Package Metadata\&quot; as UC_PACKAGE_META\n    usecase \&quot;Select Published\\nQuestion Versions\&quot; as UC_SELECT\n    usecase \&quot;Order / Section\\nPackage Items\&quot; as UC_ORDER\n    usecase \&quot;Preview Package\&quot; as UC_PACKAGE_PREVIEW\n    usecase \&quot;Save Draft\&quot; as UC_DRAFT\n    usecase \&quot;Submit for Review\&quot; as UC_SUBMIT\n  }\n  package \&quot;Review Workflow\&quot; {\n    usecase \&quot;Validate Required Fields\&quot; as UC_VALIDATE\n    usecase \&quot;Review Content\&quot; as UC_REVIEW\n    usecase \&quot;Request Revision\&quot; as UC_REVISION\n    usecase \&quot;Approve Version\&quot; as UC_APPROVE\n  }\n  package \&quot;Publishing\&quot; {\n    usecase \&quot;Publish / Schedule Version\&quot; as UC_PUBLISH\n    usecase \&quot;Unpublish / Archive\&quot; as UC_ARCHIVE\n    usecase \&quot;View Audit History\&quot; as UC_AUDIT\n  }\n}\n\nAuthor --&gt; UC_MATERIAL\nAuthor --&gt; UC_QUESTION\nAuthor --&gt; UC_PACKAGE\nAuthor --&gt; UC_ASSET\nAuthor --&gt; UC_PREVIEW\nAuthor --&gt; UC_DRAFT\nAuthor --&gt; UC_SUBMIT\nReviewer --&gt; UC_REVIEW\nReviewer --&gt; UC_REVISION\nReviewer --&gt; UC_APPROVE\nAdmin --&gt; UC_PUBLISH\nAdmin --&gt; UC_ARCHIVE\nAdmin --&gt; UC_AUDIT\n\nUC_MATERIAL ..&gt; UC_TAXONOMY : &lt;&lt;include&gt;&gt;\nUC_MATERIAL ..&gt; UC_RIGHTS : &lt;&lt;include&gt;&gt;\nUC_QUESTION ..&gt; UC_TAXONOMY : &lt;&lt;include&gt;&gt;\nUC_QUESTION ..&gt; UC_RIGHTS : &lt;&lt;include&gt;&gt;\nUC_QUESTION ..&gt; UC_SCORING : &lt;&lt;include&gt;&gt;\nUC_QUESTION ..&gt; UC_RELATED : &lt;&lt;extend&gt;&gt;\nUC_QUESTION ..&gt; UC_ASSET : &lt;&lt;extend&gt;&gt;\nUC_PACKAGE ..&gt; UC_PACKAGE_META : &lt;&lt;include&gt;&gt;\nUC_PACKAGE ..&gt; UC_SELECT : &lt;&lt;include&gt;&gt;\nUC_PACKAGE ..&gt; UC_ORDER : &lt;&lt;include&gt;&gt;\nUC_PACKAGE ..&gt; UC_PACKAGE_PREVIEW : &lt;&lt;include&gt;&gt;\nUC_SUBMIT ..&gt; UC_VALIDATE : &lt;&lt;include&gt;&gt;\nUC_REVIEW ..&gt; UC_REVISION : &lt;&lt;extend&gt;&gt;\nUC_REVIEW ..&gt; UC_APPROVE : &lt;&lt;extend&gt;&gt;\nUC_PUBLISH ..&gt; UC_APPROVE : &lt;&lt;include&gt;&gt;\n\nnote bottom of UC_PACKAGE_META\n  Topic-focused practice packages may point to a taxonomy node.\n  Full tryouts may span multiple sections instead.\nend note\nnote bottom of UC_SELECT\n  Package composition uses exact published Question Versions.\n  Taxonomy metadata never auto-selects runtime questions.\nend note\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1650" svgContentHeight="1050" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="usecase-wrap-28" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-03-f474d0c2cb">
