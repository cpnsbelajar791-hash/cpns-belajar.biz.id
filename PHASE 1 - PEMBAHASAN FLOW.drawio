attempt_id, first item, server time\nWeb --&gt; Learner : Open secure tryout interface\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1240" svgContentHeight="720" svgSizingStats="{&quot;participants&quot;:6,&quot;messages&quot;:15,&quot;fragments&quot;:0,&quot;dividers&quot;:0,&quot;notes&quot;:0}" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="sequence-wrap-44" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-12-404dea5089">
