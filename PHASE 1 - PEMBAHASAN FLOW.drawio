        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nskinparam wrapWidth 180\n&lt;style&gt;\nActivityDiagram {\n  MaximumWidth 240\n}\n&lt;/style&gt;\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam activityBackgroundColor #EFF6FF\nskinparam activityBorderColor #2563EB\nskinparam activityFontColor #0F172A\nskinparam activityDiamondBackgroundColor #FFF7ED\nskinparam activityDiamondBorderColor #F97316\nskinparam activityStartColor #16A34A\nskinparam activityEndColor #DC2626\nskinparam partitionBackgroundColor #F8FAFC\nskinparam partitionBorderColor #CBD5E1\nskinparam partitionFontColor #334155\ntitle Activity — Access and Study Learning Material\n|Learner|\nstart\n:Open roadmap or material page;\n|Web App|\n:Request published material\\nversion;\n|Content Service|\n:Load material and effective\\nversion;\nif (Published and effective?) then (yes)\n  :Check learner entitlement;\n  if (Entitled?) then (yes)\n    :Return sanitized material\\npayload;\n  else (no)\n    |Web App|\n    :Show locked state and upgrade\\nCTA;\n    stop\n  endif\nelse (no)\n  :Return unavailable response;\n  stop\nendif\n|Object Storage / CDN|\n:Serve images, tables, and\\nsupporting assets;\n|Web App|\n:Render sections and resume\\nposition;\n|Learner|\n:Read material;\nif (Bookmark or complete?) then (yes)\n  |Progress Service|\n  :Save bookmark, position, and\\ncompletion idempotently;\n  |Database|\n  :Persist UserProgress and\\nMasteryEvent;\nendif\n|Web App|\n:Recommend next material or\\npractice set;\nstop\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1100" svgContentHeight="1450" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="activity-wrap-30" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-06-6aef94c6b7">
