  <diagram name="16 · ERD — IDENTITY &amp; RBAC" id="IM5y6GCH_DE1UMz8scKg">
    <mxGraphModel dx="1437" dy="941" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3360" pageHeight="2520" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nhide circle\nhide methods\nskinparam classAttributeIconSize 0\nskinparam classBackgroundColor #F8FAFC\nskinparam classBorderColor #2563EB\nskinparam classFontColor #0F172A\nskinparam classHeaderBackgroundColor #DBEAFE\nskinparam classHeaderFontColor #0F172A\nskinparam linetype ortho\ntitle ERD — Identity, User Profiling, CPNS Target, and RBAC\nleft to right direction\n\npackage \&quot;Identity &amp; User Profiling\&quot; {\nentity USER {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * email : varchar &lt;&lt;UQ&gt;&gt;\n  * password_hash : varchar\n  * email_verified_at : timestamp?\n  * status : enum\n  * created_at : timestamp\n}\nentity PROFILE {\n  * user_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  --\n  * display_name : varchar\n  date_of_birth : date?\n  gender : enum?\n  city : varchar?\n  province : varchar?\n  onboarding_completed_at : timestamp?\n}\nentity EDUCATION_PROFILE {\n  * user_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  --\n  * education_level : enum\n  * study_program_id : UUID &lt;&lt;FK&gt;&gt;\n  institution_name : varchar?\n  graduation_year : int?\n  gpa : numeric?\n}\nentity LEARNING_PROFILE {\n  * user_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  --\n  * focus_exam_sections : jsonb\n  weak_topics : jsonb?\n  diagnostic_level : enum?\n  daily_minutes : int?\n  updated_at : timestamp\n}\nentity CPNS_TARGET {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * user_id : UUID &lt;&lt;FK&gt;&gt;\n  * recruitment_period_id : UUID &lt;&lt;FK&gt;&gt;\n  target_agency_id : UUID? &lt;&lt;FK&gt;&gt;\n  target_formation_id : UUID? &lt;&lt;FK&gt;&gt;\n  * status : enum\n  created_at : timestamp\n  updated_at : timestamp\n}\n}\n\npackage \&quot;CPNS Reference &amp; Formation Data\&quot; {\nentity RECRUITMENT_PERIOD {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * code : varchar &lt;&lt;UQ&gt;&gt;\n  * year : int\n  name : varchar\n  status : enum\n}\nentity AGENCY {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  code : varchar? &lt;&lt;UQ&gt;&gt;\n  * name : varchar\n  * type : enum\n  * is_active : boolean\n}\nentity POSITION {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  code : varchar? &lt;&lt;UQ&gt;&gt;\n  * name : varchar\n  description : text?\n}\nentity PLACEMENT_UNIT {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * agency_id : UUID &lt;&lt;FK&gt;&gt;\n  code : varchar?\n  * name : varchar\n}\nentity STUDY_PROGRAM {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  code : varchar? &lt;&lt;UQ&gt;&gt;\n  * education_level : enum\n  * name : varchar\n}\nentity FORMATION {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * recruitment_period_id : UUID &lt;&lt;FK&gt;&gt;\n  * agency_id : UUID &lt;&lt;FK&gt;&gt;\n  * position_id : UUID &lt;&lt;FK&gt;&gt;\n  placement_unit_id : UUID? &lt;&lt;FK&gt;&gt;\n  quota : int?\n  income_min : numeric?\n  income_max : numeric?\n  source_url : text?\n}\nentity FORMATION_EDUCATION {\n  * formation_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  * study_program_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  --\n  required_education_level : enum\n}\n}\n\npackage \&quot;RBAC, Session &amp; Audit\&quot; {\nentity ROLE {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * code : varchar &lt;&lt;UQ&gt;&gt;\n  name : varchar\n}\nentity PERMISSION {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * code : varchar &lt;&lt;UQ&gt;&gt;\n  module : varchar\n  action : varchar\n}\nentity USER_ROLE {\n  * user_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  * role_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  --\n  scope : jsonb?\n  granted_at : timestamp\n}\nentity ROLE_PERMISSION {\n  * role_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  * permission_id : UUID &lt;&lt;PK,FK&gt;&gt;\n}\nentity SESSION {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * user_id : UUID &lt;&lt;FK&gt;&gt;\n  token_hash : varchar\n  expires_at : timestamp\n  revoked_at : timestamp?\n}\nentity AUDIT_LOG {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  actor_user_id : UUID? &lt;&lt;FK&gt;&gt;\n  action : varchar\n  resource_type : varchar\n  resource_id : UUID?\n  payload : jsonb\n  created_at : timestamp\n}\n}\n\nUSER ||--|| PROFILE\nUSER ||--|| EDUCATION_PROFILE\nUSER ||--|| LEARNING_PROFILE\nUSER ||--o{ CPNS_TARGET\n\nSTUDY_PROGRAM ||--o{ EDUCATION_PROFILE\nRECRUITMENT_PERIOD ||--o{ CPNS_TARGET\nAGENCY |o--o{ CPNS_TARGET : partial target\nFORMATION |o--o{ CPNS_TARGET : selected target\n\nRECRUITMENT_PERIOD ||--o{ FORMATION\nAGENCY ||--o{ FORMATION\nPOSITION ||--o{ FORMATION\nAGENCY ||--o{ PLACEMENT_UNIT\nPLACEMENT_UNIT |o--o{ FORMATION\nFORMATION ||--o{ FORMATION_EDUCATION\nSTUDY_PROGRAM ||--o{ FORMATION_EDUCATION\n\nUSER ||--o{ USER_ROLE\nROLE ||--o{ USER_ROLE\nROLE ||--o{ ROLE_PERMISSION\nPERMISSION ||--o{ ROLE_PERMISSION\nUSER ||--o{ SESSION\nUSER |o--o{ AUDIT_LOG : actor\n\nnote bottom of CPNS_TARGET\n  status:\n  UNDECIDED\n  AGENCY_SELECTED\n  FORMATION_SELECTED\n\n  Agency / formation may remain NULL\n  so onboarding is never blocked.\nend note\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="2100" svgContentHeight="1500" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="portable-font-only" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-16-160e89fb7c">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
