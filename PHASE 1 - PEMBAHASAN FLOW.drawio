  <diagram name="17 · ERD — CONTENT &amp; QUESTION BANK" id="dERWFIuOnS2RM66TSIUq">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="3120" pageHeight="2300" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nhide circle\nhide methods\nskinparam classAttributeIconSize 0\nskinparam classBackgroundColor #F8FAFC\nskinparam classBorderColor #2563EB\nskinparam classFontColor #0F172A\nskinparam classHeaderBackgroundColor #DBEAFE\nskinparam classHeaderFontColor #0F172A\nskinparam linetype ortho\nleft to right direction\ntitle ERD — Learning Content, Taxonomy, Study Roadmap, and Question Bank\n\nentity STUDY_ROADMAP {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * exam_type : enum\n  * title : varchar\n  status : enum\n}\nentity ROADMAP_ITEM {\n  * roadmap_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  * material_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  --\n  * position : int\n}\nentity CATEGORY {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  parent_id : UUID? &lt;&lt;FK&gt;&gt;\n  exam_type : enum\n  name : varchar\n  slug : varchar\n}\nentity MATERIAL {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * category_id : UUID &lt;&lt;FK&gt;&gt;\n  slug : varchar &lt;&lt;UQ&gt;&gt;\n  access_tier : enum\n}\nentity MATERIAL_VERSION {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * material_id : UUID &lt;&lt;FK&gt;&gt;\n  * version_no : int\n  title : varchar\n  summary : text?\n  source_md : text?\n  editor_json : jsonb?\n  content_json : jsonb\n  status : enum\n  effective_at : timestamp?\n}\nentity QUESTION {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * category_id : UUID &lt;&lt;FK&gt;&gt;\n  question_type : enum\n  difficulty : enum\n  access_tier : enum\n}\nentity QUESTION_VERSION {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * question_id : UUID &lt;&lt;FK&gt;&gt;\n  * version_no : int\n  source_md : text?\n  editor_json : jsonb?\n  stem_json : jsonb\n  options_json : jsonb\n  answer_key_json : jsonb\n  explanation_json : jsonb\n  status : enum\n}\nentity QUESTION_MATERIAL {\n  * question_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  * material_id : UUID &lt;&lt;PK,FK&gt;&gt;\n}\nentity ASSET {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  storage_key : varchar &lt;&lt;UQ&gt;&gt;\n  mime_type : varchar\n  width_px : int?\n  height_px : int?\n  checksum : varchar\n  rights_status : enum\n  source_page : int?\n  crop_parent_id : UUID? &lt;&lt;FK&gt;&gt;\n}\n\nSTUDY_ROADMAP ||--|{ ROADMAP_ITEM\nMATERIAL ||--o{ ROADMAP_ITEM\nCATEGORY ||--o{ CATEGORY : parent\nCATEGORY ||--o{ MATERIAL\nCATEGORY ||--o{ QUESTION\nMATERIAL ||--o{ MATERIAL_VERSION\nQUESTION ||--o{ QUESTION_VERSION\nQUESTION ||--o{ QUESTION_MATERIAL\nMATERIAL ||--o{ QUESTION_MATERIAL\nMATERIAL_VERSION ..&gt; ASSET : content_json assetId\nQUESTION_VERSION ..&gt; ASSET : JSON assetId\nASSET |o--o{ ASSET : crop source\n\nnote bottom of CATEGORY\n  Recursive taxonomy tree. Example:\n  TIU &gt; Numerik &gt; Pecahan &gt; Operasi Pecahan.\n  Material and Question point to the most specific\n  relevant node; no separate submaterial tables.\nend note\nnote bottom of STUDY_ROADMAP\n  Roadmap controls recommended order only.\n  No prerequisite relation and no progress lock.\nend note\nnote bottom of QUESTION_MATERIAL\n  Optional explicit related-material mapping.\n  Used when a question should recommend one or more\n  specific materials, including Wrong Answer Review.\nend note\nnote bottom of MATERIAL_VERSION\n  summary is optional card/excerpt metadata;\n  the full learning body lives in content_json.\n\n  editor_json keeps editor working state,\n  including declared advanced blocks.\n  Body marker IDs are resolved into typed blocks\n  before preview/public content_json is rendered.\n  Blocks stay inside JSON, not relational tables.\nend note\nnote bottom of QUESTION_VERSION\n  Question content is structured JSON too.\n  stem/options/explanation may contain the block\n  types supported by their renderer context.\nend note\nnote bottom of ASSET\n  JSON stores assetId references only.\n  Binary files live in Firebase Storage.\nend note\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1900" svgContentHeight="1350" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="portable-font-only" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-17-f76d8f3a9d">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="2160" width="3040" x="40" y="40" as="geometry" />
          </mxCell>
        </UserObject>
