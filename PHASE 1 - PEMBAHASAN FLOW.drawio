BACK\n    usecase \&quot;Run Timed Tryout\&quot; as UC_TRYOUT\n    usecase \&quot;Autosave Answers\&quot; as UC_AUTOSAVE\n    usecase \&quot;Submit / Auto-submit\&quot; as UC_SUBMIT\n    usecase \&quot;View Score &amp; Competency\\nAnalysis\&quot; as UC_RESULT\n    usecase \&quot;Review Wrong Answers\&quot; as UC_REMEDIATE\n  }\n  package \&quot;Membership &amp; Billing\&quot; {\n    usecase \&quot;View Plans &amp; Checkout\&quot; as UC_CHECKOUT\n    usecase \&quot;View Subscription Status\&quot; as UC_SUBSCRIPTION\n    usecase \&quot;View Billing &amp; Payment\\nHistory\&quot; as UC_BILLING\n  }\n}\n\nGuest --&gt; UC_REGISTER\nGuest --&gt; UC_LOGIN\nLearner --&gt; UC_PROFILE\nLearner --&gt; UC_EDIT_PROFILE\nLearner --&gt; UC_TARGET\nLearner --&gt; UC_FOCUS\nLearner --&gt; UC_DELETE\nLearner --&gt; UC_ROADMAP\nLearner --&gt; UC_MATERIAL\nLearner --&gt; UC_PRACTICE\nLearner --&gt; UC_CHECKOUT\nLearner --&gt; UC_SUBSCRIPTION\nLearner --&gt; UC_BILLING\nPremium --&gt; UC_TRYOUT\nPremium --&gt; UC_RESULT\nPremium --&gt; UC_REMEDIATE\n\nUC_EDIT_PROFILE ..&gt; UC_TARGET : &lt;&lt;extend&gt;&gt;\nUC_EDIT_PROFILE ..&gt; UC_FOCUS : &lt;&lt;extend&gt;&gt;\nUC_MATERIAL ..&gt; UC_BOOKMARK : &lt;&lt;extend&gt;&gt;\nUC_PRACTICE ..&gt; UC_FEEDBACK : &lt;&lt;include&gt;&gt;\nUC_TRYOUT ..&gt; UC_AUTOSAVE : &lt;&lt;include&gt;&gt;\nUC_TRYOUT ..&gt; UC_SUBMIT : &lt;&lt;include&gt;&gt;\nUC_SUBMIT ..&gt; UC_RESULT : &lt;&lt;include&gt;&gt;\nUC_RESULT ..&gt; UC_REMEDIATE : &lt;&lt;extend&gt;&gt;\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1850" svgContentHeight="1200" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="usecase-wrap-28" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-02-df613aadca">
