    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1840" pageHeight="2452" background="#FFFFFF" math="0" shadow="0">
      <root>
