        <mxCell id="guide-sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontColor=#475569;" value="PlantUML SVG edition fixed at the source level: long activity labels, decisions, sequence messages, and use-case names wrap before PlantUML renders them. The SVG is no longer made visually wide by one long sentence." vertex="1">
          <mxGeometry height="50" width="1460" x="70" y="135" as="geometry" />
        </mxCell>
        <mxCell id="guide-left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontSize=16;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;" value="&lt;b&gt;01&lt;/b&gt; — System Context&lt;br&gt;&lt;b&gt;02&lt;/b&gt; — Use Case — Learner&lt;br&gt;&lt;b&gt;03&lt;/b&gt; — Use Case — Content Management&lt;br&gt;&lt;b&gt;04&lt;/b&gt; — Use Case — Commerce &amp; Administration&lt;br&gt;&lt;b&gt;05&lt;/b&gt; — Activity — Register &amp; Onboarding&lt;br&gt;&lt;b&gt;06&lt;/b&gt; — Activity — Learn Material&lt;br&gt;&lt;b&gt;07&lt;/b&gt; — Activity — Practice Question&lt;br&gt;&lt;b&gt;08&lt;/b&gt; — Activity — Timed Tryout&lt;br&gt;&lt;b&gt;09&lt;/b&gt; — Activity — Review Wrong Answers&lt;br&gt;&lt;b&gt;10&lt;/b&gt; — Activity — Subscription Payment&lt;br&gt;&lt;b&gt;11&lt;/b&gt; — Activity — Review &amp; Publish Content" vertex="1">
