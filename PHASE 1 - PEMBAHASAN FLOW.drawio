        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam componentBackgroundColor #EFF6FF\nskinparam componentBorderColor #2563EB\nskinparam componentFontColor #0F172A\nskinparam nodeBackgroundColor #F8FAFC\nskinparam nodeBorderColor #64748B\nskinparam nodeFontColor #0F172A\nskinparam databaseBackgroundColor #ECFDF5\nskinparam databaseBorderColor #16A34A\nskinparam databaseFontColor #064E3B\nskinparam cloudBackgroundColor #FFF7ED\nskinparam cloudBorderColor #F97316\nskinparam queueBackgroundColor #F5F3FF\nskinparam queueBorderColor #7C3AED\nskinparam queueFontColor #4C1D95\nskinparam linetype ortho\ntitle CPNS Mastery \u2014 Target Deployment Architecture\nleft to right direction\nactor Learner\nactor \&quot;Admin / Reviewer\&quot; as Admin\ncloud \&quot;Internet\&quot; {\n  node \&quot;HTTPS Edge\&quot; as LB\n}\nnode \&quot;Target Application Platform\&quot; {\n  node \&quot;Firebase App Hosting\&quot; {\n    artifact \&quot;Learner Web\&quot; as LearnerWeb\n    artifact \&quot;Admin CMS\&quot; as AdminWeb\n  }\n  node \&quot;Backend Runtime \u2014 Horizontal Autoscaling\&quot; {\n    artifact \&quot;API / BFF\&quot; as API\n    artifact \&quot;Identity\&quot; as Identity\n    artifact \&quot;Content\&quot; as Content\n    artifact \&quot;Assessment &amp; Scoring\&quot; as Assessment\n    artifact \&quot;Progress\&quot; as Progress\n    artifact \&quot;Billing\&quot; as Billing\n    artifact \&quot;Workers\&quot; as Workers\n  }\n  database \&quot;Neon PostgreSQL\&quot; as CloudSQL\n  queue \&quot;Kafka\&quot; as PubSub\n  cloud \&quot;Firebase Storage\&quot; as GCS\n  node \&quot;Managed Cache\&quot; as Cache\n  node \&quot;Secrets Manager\&quot; as Secrets\n  node \&quot;Logging / Monitoring / Trace\&quot; as Observability\n}\ncloud \&quot;Xendit\\nPayment Gateway\&quot; as Gateway\ncloud \&quot;Resend\\nEmail Provider\&quot; as Email\n\nLearner --&gt; LB : HTTPS\nAdmin --&gt; LB : HTTPS\nLB --&gt; LearnerWeb\nLB --&gt; AdminWeb\nLearnerWeb --&gt; API : HTTPS\nAdminWeb --&gt; API : HTTPS\nAPI --&gt; Identity\nAPI --&gt; Content\nAPI --&gt; Assessment\nAPI --&gt; Progress\nAPI --&gt; Billing\nIdentity --&gt; CloudSQL\nContent --&gt; CloudSQL\nAssessment --&gt; CloudSQL\nProgress --&gt; CloudSQL\nBilling --&gt; CloudSQL\nContent --&gt; GCS\nAssessment --&gt; GCS\nAPI --&gt; Cache\nContent --&gt; PubSub\nAssessment --&gt; PubSub\nBilling --&gt; PubSub\nPubSub --&gt; Workers\nWorkers --&gt; CloudSQL\nBilling --&gt; Gateway : outbound HTTPS\nWorkers --&gt; Email : outbound HTTPS\nAPI --&gt; Secrets\nWorkers --&gt; Secrets\nAPI --&gt; Observability\nWorkers --&gt; Observability\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1750" svgContentHeight="1100" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="portable-font-only" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-21-3331343fa7">
