  <diagram name="07 · ACTIVITY — PRACTICE PACKAGE" id="De72pSM7pQIZYGP3Ykk5">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1840" pageHeight="2612" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nskinparam wrapWidth 180\n&lt;style&gt;\nActivityDiagram {\n  MaximumWidth 240\n}\n&lt;/style&gt;\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam activityBackgroundColor #EFF6FF\nskinparam activityBorderColor #2563EB\nskinparam activityFontColor #0F172A\nskinparam activityDiamondBackgroundColor #FFF7ED\nskinparam activityDiamondBorderColor #F97316\nskinparam activityStartColor #16A34A\nskinparam activityEndColor #DC2626\nskinparam partitionBackgroundColor #F8FAFC\nskinparam partitionBorderColor #CBD5E1\nskinparam partitionFontColor #334155\ntitle Activity — Practice Package with Immediate Feedback\n|Learner|\nstart\n:Choose configured practice package;\n|Assessment Service|\n:Check package publication,\nentitlement, and metadata;\n:Load exact configured\nPACKAGE_ITEM list;\n:Create practice attempt\nsnapshot;\nnote right\n  Content Creator fixes package composition\n  and order before publication.\n  Taxonomy metadata is for catalog/filtering,\n  not dynamic question selection.\nend note\nrepeat\n  |Assessment Service|\n  :Load next configured PACKAGE_ITEM\nand snapshotted QUESTION_VERSION;\n  |Web App|\n  :Render allowed structured question blocks\n(text / image / formula / figural)\nand referenced assets;\n  |Learner|\n  :Select option and press Check;\n  |Assessment Service|\n  :Validate attempt ownership and\nitem;\n  :Save answer idempotently;\n  :Evaluate answer server-side;\n  |Database|\n  :Persist AttemptAnswer and\nresponse version;\n  |Web App|\n  :Show correctness and\nexplanation;\nrepeat while (Remaining configured\npackage items?) is (yes)\n|Assessment Service|\n:Finalize practice attempt;\n|Database|\n:Persist AttemptResult;\n|Web App|\n:Show summary and Review\nWrong Answers action;\nnote right\n  Embedded mini-quiz blocks inside a learning\n  material stay in the Learn Material flow.\n  This activity is a standalone Practice Package.\nend note\nstop\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1100" svgContentHeight="1550" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="activity-wrap-30" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-07-4c7d93b365">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
