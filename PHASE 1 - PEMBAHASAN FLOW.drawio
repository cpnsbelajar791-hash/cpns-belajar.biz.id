        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nhide circle\nhide methods\nskinparam classAttributeIconSize 0\nskinparam classBackgroundColor #F8FAFC\nskinparam classBorderColor #2563EB\nskinparam classFontColor #0F172A\nskinparam classHeaderBackgroundColor #DBEAFE\nskinparam classHeaderFontColor #0F172A\nskinparam linetype ortho\ntitle ERD \u2014 Assessment, Tryout, Result, and Learning Progress\nentity QUESTION_PACKAGE {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  name : varchar\n  package_type : enum\n  duration_minutes : int?\n  attempt_limit : int?\n  status : enum\n  scoring_config_id : UUID &lt;&lt;FK&gt;&gt;\n}\nentity PACKAGE_ITEM {\n  * package_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  * position : int &lt;&lt;PK&gt;&gt;\n  --\n  * question_version_id : UUID &lt;&lt;FK&gt;&gt;\n  section_code : varchar?\n}\nentity SCORING_CONFIG {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  model : enum\n  configuration : jsonb\n  version : int\n}\nentity TRYOUT_ATTEMPT {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * user_id : UUID &lt;&lt;FK&gt;&gt;\n  * package_id : UUID &lt;&lt;FK&gt;&gt;\n  snapshot : jsonb\n  started_at : timestamp\n  expires_at : timestamp\n  submitted_at : timestamp?\n  status : enum\n}\nentity ATTEMPT_ANSWER {\n  * attempt_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  * package_item_position : int &lt;&lt;PK&gt;&gt;\n  --\n  selected_option_id : UUID?\n  response_payload : jsonb?\n  is_flagged : boolean\n  response_version : int\n  answered_at : timestamp?\n}\nentity ATTEMPT_RESULT {\n  * attempt_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  --\n  total_score : numeric\n  max_score : numeric\n  competency_breakdown : jsonb\n  calculated_at : timestamp\n}\nentity USER_PROGRESS {\n  * user_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  * competency_key : varchar &lt;&lt;PK&gt;&gt;\n  --\n  mastery_score : numeric\n  evidence_count : int\n  updated_at : timestamp\n}\nentity REMEDIATION_ITEM {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * user_id : UUID &lt;&lt;FK&gt;&gt;\n  * question_id : UUID &lt;&lt;FK&gt;&gt;\n  source_attempt_id : UUID? &lt;&lt;FK&gt;&gt;\n  priority : int\n  next_review_at : timestamp?\n  resolved_at : timestamp?\n}\nSCORING_CONFIG ||--o{ QUESTION_PACKAGE\nQUESTION_PACKAGE ||--|{ PACKAGE_ITEM\nQUESTION_PACKAGE ||--o{ TRYOUT_ATTEMPT\nTRYOUT_ATTEMPT ||--o{ ATTEMPT_ANSWER\nTRYOUT_ATTEMPT ||--o| ATTEMPT_RESULT\nTRYOUT_ATTEMPT ||--o{ REMEDIATION_ITEM : source\nUSER ||--o{ TRYOUT_ATTEMPT\nUSER ||--o{ USER_PROGRESS\nUSER ||--o{ REMEDIATION_ITEM\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="preserve" svgContentWidth="1650" svgContentHeight="1150" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="portable-font-only" fontPolicy="SansSerif-portable" renderPolicy="source-first-wrap;svg-aspect-preserved" id="g-18-ff6dcb09cc">
