  <diagram name="19 · ERD — SUBSCRIPTION &amp; PAYMENT" id="AxMuI6tbOpvupU5R6Et7">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2560" pageHeight="1892" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
