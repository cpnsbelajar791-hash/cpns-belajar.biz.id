        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nskinparam wrapWidth 180\n&lt;style&gt;\nActivityDiagram {\n  MaximumWidth 240\n}\n&lt;/style&gt;\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam activityBackgroundColor #EFF6FF\nskinparam activityBorderColor #2563EB\nskinparam activityFontColor #0F172A\nskinparam activityDiamondBackgroundColor #FFF7ED\nskinparam activityDiamondBorderColor #F97316\nskinparam activityStartColor #16A34A\nskinparam activityEndColor #DC2626\nskinparam partitionBackgroundColor #F8FAFC\nskinparam partitionBorderColor #CBD5E1\nskinparam partitionFontColor #334155\ntitle Activity — Review Wrong Answers\n|Learner|\nstart\n:Open wrong-answer review;\n|Progress Service|\n:Load incorrect answers from\\ncompleted attempt data;\nrepeat\n  |Content Service|\n  :Load current question,\\ncorrect answer, explanation,\\nand related material if available;\n  |Web App|\n  :Show wrong question, learner\\nanswer, correct answer,\\nexplanation, and material link;\n  |Learner|\n  if (Open related material?) then (yes)\n    :Open related material;\n    :Return to wrong-answer review;\n  endif\nrepeat while (More wrong answers?) is (yes) not (no)\n|Web App|\n:Finish review;\nstop\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1100" svgContentHeight="1450" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="activity-wrap-30" fontPolicy="SansSerif-