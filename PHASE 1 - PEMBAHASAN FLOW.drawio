        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam actorBorderColor #0F172A\nskinparam actorFontColor #0F172A\nskinparam usecaseBackgroundColor #EFF6FF\nskinparam usecaseBorderColor #2563EB\nskinparam usecaseFontColor #0F172A\nskinparam rectangleBackgroundColor #F8FAFC\nskinparam rectangleBorderColor #94A3B8\nskinparam rectangleFontColor #334155\nskinparam packageStyle rectangle\ntitle CPNS Mastery \u2014 Commerce &amp; Administration Use Cases\nleft to right direction\nactor Learner\nactor \&quot;Super Admin\&quot; as Admin\nactor \&quot;Payment Gateway\&quot; as Gateway\nactor \&quot;Notification Provider\&quot; as Notification\n\nrectangle \&quot;Commerce &amp; Platform Administration\&quot; {\n  package \&quot;Subscription &amp; Payment\&quot; {\n    usecase \&quot;Browse Plans\&quot; as UC_PLANS\n    usecase \&quot;Create Checkout\&quot; as UC_CHECKOUT\n    usecase \&quot;Process Payment\&quot; as UC_PAYMENT\n    usecase \&quot;Verify Payment Callback\&quot; as UC_CALLBACK\n    usecase \&quot;Activate / Extend\\nSubscription\&quot; as UC_ACTIVATE\n    usecase \&quot;Issue Invoice / Notification\&quot; as UC_INVOICE\n    usecase \&quot;Retry Failed Payment\&quot; as UC_RETRY\n  }\n  package \&quot;Administration\&quot; {\n    usecase \&quot;Manage Users &amp; Roles\&quot; as UC_USERS\n    usecase \&quot;Manage Plans &amp; Entitlements\&quot; as UC_ENTITLEMENTS\n    usecase \&quot;Manage Coupons\&quot; as UC_COUPONS\n    usecase \&quot;Review Transactions\&quot; as UC_TRANSACTIONS\n    usecase \&quot;Handle Refund / Adjustment\&quot; as UC_REFUND\n    usecase \&quot;View Audit &amp; Operational\\nReports\&quot; as UC_REPORTS\n  }\n}\n\nLearner --&gt; UC_PLANS\nLearner --&gt; UC_CHECKOUT\nLearner --&gt; UC_RETRY\nGateway --&gt; UC_PAYMENT\nGateway --&gt; UC_CALLBACK\nNotification --&gt; UC_INVOICE\nAdmin --&gt; UC_USERS\nAdmin --&gt; UC_ENTITLEMENTS\nAdmin --&gt; UC_COUPONS\nAdmin --&gt; UC_TRANSACTIONS\nAdmin --&gt; UC_REFUND\nAdmin --&gt; UC_REPORTS\n\nUC_CHECKOUT ..&gt; UC_PAYMENT : &lt;&lt;include&gt;&gt;\nUC_PAYMENT ..&gt; UC_CALLBACK : &lt;&lt;include&gt;&gt;\nUC_CALLBACK ..&gt; UC_ACTIVATE : &lt;&lt;include&gt;&gt;\nUC_ACTIVATE ..&gt; UC_INVOICE : &lt;&lt;include&gt;&gt;\nUC_PAYMENT ..&gt; UC_RETRY : &lt;&lt;extend&gt;&gt;\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="preserve" svgContentWidth="1600" svgContentHeight="1000" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="usecase-wrap-28" fontPolicy="SansSerif-portable" renderPolicy="source-first-wrap;svg-aspect-preserved" id="g-04-429c2162f1">
