t interface\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="preserve" svgContentWidth="1240" svgContentHeight="720" svgSizingStats="{&quot;participants&quot;:6,&quot;messages&quot;:15,&quot;fragments&quot;:0,&quot;dividers&quot;:0,&quot;notes&quot;:0}" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="sequence-wrap-44" fontPolicy="SansSerif-portable" renderPolicy="source-first-wrap;svg-aspect-preserved" id="g-12-404dea5089">
