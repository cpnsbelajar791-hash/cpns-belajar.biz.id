  <diagram name="13 · SEQUENCE — AUTOSAVE &amp; SUBMIT TRYOUT" id="Ihiaja2XH4lM1ynKOZ3A">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1952" pageHeight="1764" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nhide footbox\nskinparam maxMessageSize 44\nskinparam ParticipantPadding 24\nskinparam BoxPadding 12\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam sequence {\n  ArrowColor #475569\n  LifeLineBorderColor #64748B\n  LifeLineBackgroundColor #F8FAFC\n  ParticipantBorderColor #2563EB\n  ParticipantBackgroundColor #EFF6FF\n  ParticipantFontColor #0F172A\n  ActorBorderColor #0F172A\n  ActorBackgroundColor #FFFFFF\n  ActorFontColor #0F172A\n  GroupBorderColor #94A3B8\n  GroupBackgroundColor #F8FAFC\n  GroupHeaderFontColor #334155\n  DividerBackgroundColor #E2E8F0\n  DividerBorderColor #94A3B8\n}\ntitle Sequence — Autosave and Finalize a Tryout\nautonumber\nactor Learner\nparticipant \&quot;Web App\&quot; as Web\nparticipant \&quot;Assessment API\&quot; as API\ndatabase \&quot;Primary DB\&quot; as DB\nparticipant \&quot;Scoring Service\&quot; as Scoring\n\nloop Each answer change\n  Learner -&gt; Web : Select option / flag item\n  Web -&gt; API : PUT /attempts/{id}/answers/{item}\\nresponse_version + idempotency key\n  API -&gt; DB : Verify ownership and attempt status\n  DB --&gt; API : Current version / expires_at\n  API -&gt; DB : UPSERT answer if version is current\n  DB --&gt; API : Saved version\n  API --&gt; Web : saved_at + server remaining time\nend\n\nalt Learner submits before expiry\n  Learner -&gt; Web : Confirm submit\n  Web -&gt; API : POST /attempts/{id}/submit\nelse Server time reaches expiry\n  Web -&gt; API : POST /attempts/{id}/submit?reason=expired\nend\n\nAPI -&gt; DB : Atomically lock attempt and set SUBMITTED\nDB --&gt; API : Final answer snapshot\nAPI -&gt; Scoring : Score using attempt snapshot\nScoring --&gt; API : Total + competency breakdown\nAPI -&gt; DB : Persist AttemptResult\nnote over API, DB\n  Wrong-answer review is derived later\n  from saved completed-attempt data.\n  No remediation queue is created.\nend note\nAPI --&gt; Web : Result summary + review action\nWeb --&gt; Learner : Score, analysis, Review Wrong Answers\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1170" svgContentHeight="1020" svgSizingStats="{&quot;participants&quot;:6,&quot;messages&quot;:19,&quot;fragments&quot;:3,&quot;dividers&quot;:0,&quot;notes&quot;:0}" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="sequence-wrap-44" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-13-f75d412a8c">
