        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nskinparam wrapWidth 180\n&lt;style&gt;\nActivityDiagram {\n  MaximumWidth 240\n}\n&lt;/style&gt;\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam activityBackgroundColor #EFF6FF\nskinparam activityBorderColor #2563EB\nskinparam activityFontColor #0F172A\nskinparam activityDiamondBackgroundColor #FFF7ED\nskinparam activityDiamondBorderColor #F97316\nskinparam activityStartColor #16A34A\nskinparam activityEndColor #DC2626\nskinparam partitionBackgroundColor #F8FAFC\nskinparam partitionBorderColor #CBD5E1\nskinparam partitionFontColor #334155\ntitle Activity — Practice Question with Immediate Feedback\n|Learner|\nstart\n:Choose practice package;\n|Assessment Service|\n:Check package status and\\nentitlement;\n:Create practice attempt\\nsnapshot;\nrepeat\n  |Web App|\n  :Display question without\\nanswer key;\n  |Learner|\n  :Select option and press Check;\n  |Assessment Service|\n  :Validate attempt ownership and\\nitem;\n  :Save answer idempotently;\n  :Evaluate answer server-side;\n  |Database|\n  :Persist AttemptAnswer and\\nresponse version;\n  |Web App|\n  :Show correctness and\\nexplanation;\n  |Progress Service|\n  if (Answer incorrect?) then (yes)\n    :Add or update wrong-answer\\nqueue;\n  else (no)\n    :Update mastery evidence;\n  endif\nrepeat while (More questions?) is (yes)\n|Assessment Service|\n:Finalize practice attempt;\n|Progress Service|\n:Update competency progress;\n|Web App|\n:Show summary and recommended\\nreview;\nstop\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1100" svgContentHeight="1550" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="activity-wrap-30" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-07-4c7d93b365">
