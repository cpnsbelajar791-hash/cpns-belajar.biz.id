  <diagram name="10 · ACTIVITY — SUBSCRIPTION PAYMENT" id="iFyv2NZ_ayJwfDAnIfsM">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1920" pageHeight="2692" background="#FFFFFF" math="0" shadow="0">
