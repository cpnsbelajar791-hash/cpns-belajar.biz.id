  <diagram name="05 · ACTIVITY — REGISTER &amp; ONBOARDING" id="s5RVqDZ59DKFUWGtWr96">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1840" pageHeight="2532" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nskinparam wrapWidth 180\n&lt;style&gt;\nActivityDiagram {\n  MaximumWidth 240\n}\n&lt;/style&gt;\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam activityBackgroundColor #EFF6FF\nskinparam activityBorderColor #2563EB\nskinparam activityFontColor #0F172A\nskinparam activityDiamondBackgroundColor #FFF7ED\nskinparam activityDiamondBorderColor #F97316\nskinparam activityStartColor #16A34A\nskinparam activityEndColor #DC2626\nskinparam partitionBackgroundColor #F8FAFC\nskinparam partitionBorderColor #CBD5E1\nskinparam partitionFontColor #334155\ntitle Activity — Register, Verify, and Complete Onboarding\n|Learner|\nstart\n:Open Register page;\n:Enter email and password;\n|Web App|\n:Validate required fields;\n|Identity Service|\n:Apply rate limit and password\\npolicy;\nif (Email already registered?) then (yes)\n  :Return generic conflict\\nresponse;\n  |Web App|\n  :Show safe error message;\n  stop\nelse (no)\n  :Hash password and create\\npending account;\nendif\n|Database|\n:Persist User, Profile,\\nverification token;\n|Notification Service|\n:Send verification message;\n|Learner|\n:Open verification link;\n|Identity Service|\nif (Token valid and not\\nexpired?) then (yes)\n  :Mark email as verified;\n  :Create revocable session;\nelse (no)\n  :Reject token and offer resend;\n  stop\nendif\n|Web App|\n:Display onboarding form;\n|Learner|\n:Set exam target and study\\npreferences;\n|Profile Service|\n:Save onboarding profile;\n|Web App|\n:Open learner dashboard;\nstop\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1100" svgContentHeight="1500" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="activity-wrap-30" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-05-8f824a03f5">
