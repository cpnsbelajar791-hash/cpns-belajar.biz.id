  <diagram name="03 · USE CASE — CONTENT MANAGEMENT" id="KoXjhJrMN-UgHBe8JNWo">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2720" pageHeight="1812" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam actorBorderColor #0F172A\nskinparam actorFontColor #0F172A\nskinparam usecaseBackgroundColor #EFF6FF\nskinparam usecaseBorderColor #2563EB\nskinparam usecaseFontColor #0F172A\nskinparam rectangleBackgroundColor #F8FAFC\nskinparam rectangleBorderColor #94A3B8\nskinparam rectangleFontColor #334155\nskinparam packageStyle rectangle\ntitle CPNS Mastery \u2014 Content Management Use Cases\nleft to right direction\nactor \&quot;Content Admin\&quot; as Author\nactor Reviewer\nactor \&quot;Super Admin\&quot; as Admin\n\nrectangle \&quot;Content Management System\&quot; {\n  package \&quot;Authoring\&quot; {\n    usecase \&quot;Create / Edit Material\&quot; as UC_MATERIAL\n    usecase \&quot;Create / Edit Question\&quot; as UC_QUESTION\n    usecase \&quot;Upload Figural / Supporting\\nAsset\&quot; as UC_ASSET\n    usecase \&quot;Define Metadata &amp; Source\\nRights\&quot; as UC_METADATA\n    usecase \&quot;Configure Answer &amp; Scoring\&quot; as UC_SCORING\n    usecase \&quot;Preview Learner Rendering\&quot; as UC_PREVIEW\n    usecase \&quot;Save Draft\&quot; as UC_DRAFT\n    usecase \&quot;Submit for Review\&quot; as UC_SUBMIT\n  }\n  package \&quot;Review Workflow\&quot; {\n    usecase \&quot;Validate Required Fields\&quot; as UC_VALIDATE\n    usecase \&quot;Review Content\&quot; as UC_REVIEW\n    usecase \&quot;Request Revision\&quot; as UC_REVISION\n    usecase \&quot;Approve Version\&quot; as UC_APPROVE\n  }\n  package \&quot;Publishing\&quot; {\n    usecase \&quot;Publish / Schedule Version\&quot; as UC_PUBLISH\n    usecase \&quot;Unpublish / Archive\&quot; as UC_ARCHIVE\n    usecase \&quot;View Audit History\&quot; as UC_AUDIT\n  }\n}\n\nAuthor --&gt; UC_MATERIAL\nAuthor --&gt; UC_QUESTION\nAuthor --&gt; UC_ASSET\nAuthor --&gt; UC_PREVIEW\nAuthor --&gt; UC_DRAFT\nAuthor --&gt; UC_SUBMIT\nReviewer --&gt; UC_REVIEW\nReviewer --&gt; UC_REVISION\nReviewer --&gt; UC_APPROVE\nAdmin --&gt; UC_PUBLISH\nAdmin --&gt; UC_ARCHIVE\nAdmin --&gt; UC_AUDIT\n\nUC_MATERIAL ..&gt; UC_METADATA : &lt;&lt;include&gt;&gt;\nUC_QUESTION ..&gt; UC_METADATA : &lt;&lt;include&gt;&gt;\nUC_QUESTION ..&gt; UC_SCORING : &lt;&lt;include&gt;&gt;\nUC_QUESTION ..&gt; UC_ASSET : &lt;&lt;extend&gt;&gt;\nUC_SUBMIT ..&gt; UC_VALIDATE : &lt;&lt;include&gt;&gt;\nUC_REVIEW ..&gt; UC_REVISION : &lt;&lt;extend&gt;&gt;\nUC_REVIEW ..&gt; UC_APPROVE : &lt;&lt;extend&gt;&gt;\nUC_PUBLISH ..&gt; UC_APPROVE : &lt;&lt;include&gt;&gt;\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="preserve" svgContentWidth="1650" svgContentHeight="1050" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="usecase-wrap-28" fontPolicy="SansSerif-portable" renderPolicy="source-first-wrap;svg-aspect-preserved" id="g-03-f474d0c2cb">
