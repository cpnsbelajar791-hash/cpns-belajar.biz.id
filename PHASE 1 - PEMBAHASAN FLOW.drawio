  <diagram name="10 · ACTIVITY — SUBSCRIPTION PAYMENT" id="bWfmnJq-oSZlW36UCVpu">
    <mxGraphModel dx="1837" dy="941" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1920" pageHeight="2692" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nskinparam wrapWidth 180\n&lt;style&gt;\nActivityDiagram {\n  MaximumWidth 240\n}\n&lt;/style&gt;\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam activityBackgroundColor #EFF6FF\nskinparam activityBorderColor #2563EB\nskinparam activityFontColor #0F172A\nskinparam activityDiamondBackgroundColor #FFF7ED\nskinparam activityDiamondBorderColor #F97316\nskinparam activityStartColor #16A34A\nskinparam activityEndColor #DC2626\nskinparam partitionBackgroundColor #F8FAFC\nskinparam partitionBorderColor #CBD5E1\nskinparam partitionFontColor #334155\ntitle Activity — Subscription Checkout, Payment, and Cancellation\n|Learner|\nstart\n:Choose subscription plan;\nif (Already authenticated?) then (yes)\nelse (no)\n  |Web App|\n  :Save selected plan in signed\\nsession state;\n  :Redirect to login or register;\n  |Learner|\n  :Authenticate;\nendif\n|Web App|\n:Open checkout with selected\\nplan;\n|Billing Service|\n:Validate plan, price, and user\\neligibility;\n:Create PENDING transaction\\nwith unique reference;\n|Payment Gateway|\n:Create payment session;\n|Web App|\n:Show payment page and current\\ntransaction status;\n|Learner|\nif (Cancel before payment\\ncompletes?) then (yes)\n  |Billing Service|\n  :Verify transaction is still\\nPENDING;\n  |Payment Gateway|\n  :Cancel payment session if\\nprovider supports it;\n  |Billing Service|\n  :Mark transaction CANCELLED;\n  |Database|\n  :Persist cancellation and\\naudit event;\n  |Web App|\n  :Show cancelled status and\\nreturn to billing / plans;\n  stop\nelse (no)\n  :Complete or attempt payment;\nendif\n|Payment Gateway|\n:Send signed callback / webhook;\n|Billing Service|\n:Verify signature, amount,\\ncurrency, and idempotency;\n|Database|\n:Read transaction and current\\nstatus;\n|Billing Service|\nif (Transaction still eligible?) then (yes)\nelse (no — CANCELLED)\n  :Record late gateway event and\\nflag reconciliation;\n  |Database|\n  :Persist event; do NOT activate\\nsubscription;\n  |Web App|\n  :Keep cancelled status;\n  stop\nendif\nif (Payment successful?) then (yes)\n  :Mark transaction PAID;\n  :Activate or extend\\nsubscription;\n  |Database|\n  :Persist payment, entitlement,\\nand audit log;\n  |Notification Service|\n  :Send invoice and confirmation;\n  |Web App|\n  :Show success and refreshed\\naccess;\nelse (no)\n  if (Payment expired?) then (yes)\n    |Billing Service|\n    :Mark transaction EXPIRED;\n    |Web App|\n    :Show expired status and offer\\nnew checkout;\n  else (no)\n    |Billing Service|\n    :Mark transaction FAILED;\n    |Web App|\n    :Show failure and retry option\\nwithout duplicate charge;\n  endif\nendif\nstop\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1200" svgContentHeight="1900" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="activity-wrap-30" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-10-0978461449">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="2560" width="1840" x="40" y="40" as="geometry" />
          </mxCell>
        </UserObject>
