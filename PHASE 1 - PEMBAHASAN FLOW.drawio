        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nskinparam wrapWidth 180\n&lt;style&gt;\nActivityDiagram {\n  MaximumWidth 240\n}\n&lt;/style&gt;\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam activityBackgroundColor #EFF6FF\nskinparam activityBorderColor #2563EB\nskinparam activityFontColor #0F172A\nskinparam activityDiamondBackgroundColor #FFF7ED\nskinparam activityDiamondBorderColor #F97316\nskinparam activityStartColor #16A34A\nskinparam activityEndColor #DC2626\nskinparam partitionBackgroundColor #F8FAFC\nskinparam partitionBorderColor #CBD5E1\nskinparam partitionFontColor #334155\ntitle Activity — Subscription Checkout and Payment\n|Learner|\nstart\n:Choose subscription plan;\nif (Already authenticated?) then (yes)\nelse (no)\n  |Web App|\n  :Save selected plan in signed\\nsession state;\n  :Redirect to login or register;\n  |Learner|\n  :Authenticate;\nendif\n|Web App|\n:Open checkout with selected\\nplan;\n|Billing Service|\n:Validate plan, price, coupon,\\nand user eligibility;\n:Create pending transaction\\nwith unique reference;\n|Payment Gateway|\n:Create payment session;\n|Learner|\n:Complete payment;\n|Payment Gateway|\n:Send signed callback / webhook;\n|Billing Service|\n:Verify signature, amount,\\ncurrency, and idempotency;\nif (Payment successful?) then (yes)\n  :Mark transaction paid;\n  :Activate or extend\\nsubscription;\n  |Database|\n  :Persist payment, entitlement,\\nand audit log;\n  |Notification Service|\n  :Send invoice and confirmation;\n  |Web App|\n  :Show success and refreshed\\naccess;\nelse (no)\n  :Record failure or expiry;\n  |Web App|\n  :Show retry options without\\nduplicate charge;\nendif\nstop\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1150" svgContentHeight="1600" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="activity-wrap-30" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-10-0978461449">
