        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nskinparam wrapWidth 180\n&lt;style&gt;\nActivityDiagram {\n  MaximumWidth 240\n}\n&lt;/style&gt;\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam activityBackgroundColor #EFF6FF\nskinparam activityBorderColor #2563EB\nskinparam activityFontColor #0F172A\nskinparam activityDiamondBackgroundColor #FFF7ED\nskinparam activityDiamondBorderColor #F97316\nskinparam activityStartColor #16A34A\nskinparam activityEndColor #DC2626\nskinparam partitionBackgroundColor #F8FAFC\nskinparam partitionBorderColor #CBD5E1\nskinparam partitionFontColor #334155\ntitle Activity — Timed Tryout with Server-authoritative Timer\n|Learner|\nstart\n:Open tryout package;\n|Assessment Service|\n:Check package publication,\\nentitlement, and attempt limit;\nif (Eligible?) then (yes)\n  :Create immutable attempt\\nsnapshot;\n  :Set started_at and expires_at\\non server;\nelse (no)\n  |Web App|\n  :Show access or attempt-limit\\nmessage;\n  stop\nendif\n|Database|\n:Persist TryoutAttempt and\\nsnapshot references;\nrepeat\n  |Web App|\n  :Request current item and\\nremaining server time;\n  :Display question and navigator;\n  |Learner|\n  :Select answer or mark for\\nreview;\n  |Assessment Service|\n  :Validate attempt status,\\nownership, and item;\n  :Upsert answer with idempotency\\nkey;\n  |Database|\n  :Persist answer and audit\\ntimestamp;\nrepeat while (Submit requested or time\\nexpired?) is (no)\n|Assessment Service|\nif (Time expired?) then (yes)\n  :Auto-submit attempt;\nelse (manual submit)\n  :Confirm submit request;\nendif\n:Lock attempt against further\\nchanges;\n:Score from immutable snapshot;\n:Compute competency breakdown;\n|Database|\n:Persist AttemptResult and\\nremediation items;\n|Web App|\n:Show score, analysis, and\\nreview actions;\nstop\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1150" svgContentHeight="1650" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="activity-wrap-30" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-08-e5bcd3f0a1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
