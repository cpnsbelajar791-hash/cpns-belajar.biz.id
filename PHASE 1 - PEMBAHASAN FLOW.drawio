        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nhide circle\nhide methods\nskinparam classAttributeIconSize 0\nskinparam classBackgroundColor #F8FAFC\nskinparam classBorderColor #2563EB\nskinparam classFontColor #0F172A\nskinparam classHeaderBackgroundColor #DBEAFE\nskinparam classHeaderFontColor #0F172A\nskinparam linetype ortho\ntitle ERD — Subscription, Entitlement, and Payment\nentity PLAN {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * code : varchar &lt;&lt;UQ&gt;&gt;\n  name : varchar\n  duration_days : int\n  price_amount : numeric\n  currency : char(3)\n  status : enum\n}\nentity PLAN_ENTITLEMENT {\n  * plan_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  * entitlement_key : varchar &lt;&lt;PK&gt;&gt;\n  --\n  configuration : jsonb?\n}\nentity SUBSCRIPTION {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * user_id : UUID &lt;&lt;FK&gt;&gt;\n  * plan_id : UUID &lt;&lt;FK&gt;&gt;\n  starts_at : timestamp\n  ends_at : timestamp\n  status : enum\n  source_transaction_id : UUID? &lt;&lt;FK&gt;&gt;\n}\nentity PAYMENT_TRANSACTION {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * user_id : UUID &lt;&lt;FK&gt;&gt;\n  * plan_id : UUID &lt;&lt;FK&gt;&gt;\n  reference : varchar &lt;&lt;UQ&gt;&gt;\n  gateway_reference : varchar?\n  amount : numeric\n  currency : char(3)\n  status : enum\n  paid_at : timestamp?\n}\nentity PAYMENT_EVENT {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * transaction_id : UUID &lt;&lt;FK&gt;&gt;\n  gateway_event_id : varchar &lt;&lt;UQ&gt;&gt;\n  event_type : varchar\n  verified : boolean\n  payload : jsonb\n  received_at : timestamp\n}\nentity COUPON {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  code : varchar &lt;&lt;UQ&gt;&gt;\n  discount_type : enum\n  discount_value : numeric\n  valid_from : timestamp\n  valid_until : timestamp?\n  usage_limit : int?\n}\nentity COUPON_REDEMPTION {\n  * coupon_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  * transaction_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  --\n  user_id : UUID &lt;&lt;FK&gt;&gt;\n  redeemed_at : timestamp\n}\nPLAN ||--o{ PLAN_ENTITLEMENT\nPLAN ||--o{ SUBSCRIPTION\nPLAN ||--o{ PAYMENT_TRANSACTION\nUSER ||--o{ SUBSCRIPTION\nUSER ||--o{ PAYMENT_TRANSACTION\nPAYMENT_TRANSACTION ||--o{ PAYMENT_EVENT\nPAYMENT_TRANSACTION |o--o| SUBSCRIPTION : activates\nCOUPON ||--o{ COUPON_REDEMPTION\nPAYMENT_TRANSACTION ||--o| COUPON_REDEMPTION\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1550" svgContentHeight="1100" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="portable-font-only" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-19-79f4e935ae">
