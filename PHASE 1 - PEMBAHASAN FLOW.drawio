        <mxCell id="guide-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fontSize=15;fillColor=#FFF7ED;strokeColor=#F97316;fontColor=#7C2D12;" value="&lt;b&gt;Universal rule:&lt;/b&gt; control width in PlantUML source—not by stretching or guessing the Draw.io image box. Activity labels use MaximumWidth + explicit line wrapping; sequence messages use maxMessageSize; SVG aspect ratio remains locked." vertex="1">
          <mxGeometry height="90" width="1440" x="80" y="825" as="geometry" />
