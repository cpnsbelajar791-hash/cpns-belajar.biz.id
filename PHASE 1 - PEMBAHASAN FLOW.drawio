  <diagram name="18 · ERD — ASSESSMENT &amp; PROGRESS" id="uaaBgKGIv3VAJZFRo-Jx">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2720" pageHeight="1972" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nhide circle\nhide methods\nskinparam classAttributeIconSize 0\nskinparam classBackgroundColor #F8FAFC\nskinparam classBorderColor #2563EB\nskinparam classFontColor #0F172A\nskinparam classHeaderBackgroundColor #DBEAFE\nskinparam classHeaderFontColor #0F172A\nskinparam linetype ortho\ntitle ERD — Assessment, Package Composition, Result, and Learning Progress\n\nentity \&quot;CATEGORY\\n(Tab 17)\&quot; as CONTENT_CATEGORY {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n}\nentity \&quot;QUESTION_VERSION\\n(Tab 17)\&quot; as CONTENT_QUESTION_VERSION {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n}\nentity QUESTION_PACKAGE {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  name : varchar\n  package_type : enum\n  category_id : UUID? &lt;&lt;FK&gt;&gt;\n  difficulty : enum?\n  duration_minutes : int?\n  attempt_limit : int?\n  status : enum\n  scoring_config_id : UUID &lt;&lt;FK&gt;&gt;\n}\nentity PACKAGE_ITEM {\n  * package_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  * position : int &lt;&lt;PK&gt;&gt;\n  --\n  * question_version_id : UUID &lt;&lt;FK&gt;&gt;\n  section_code : varchar?\n}\nentity SCORING_CONFIG {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  model : enum\n  configuration : jsonb\n  version : int\n}\nentity TRYOUT_ATTEMPT {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * user_id : UUID &lt;&lt;FK&gt;&gt;\n  * package_id : UUID &lt;&lt;FK&gt;&gt;\n  snapshot : jsonb\n  started_at : timestamp\n  expires_at : timestamp\n  submitted_at : timestamp?\n  status : enum\n}\nentity ATTEMPT_ANSWER {\n  * attempt_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  * package_item_position : int &lt;&lt;PK&gt;&gt;\n  --\n  selected_option_id : UUID?\n  response_payload : jsonb?\n  is_flagged : boolean\n  response_version : int\n  answered_at : timestamp?\n}\nentity ATTEMPT_RESULT {\n  * attempt_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  --\n  total_score : numeric\n  max_score : numeric\n  competency_breakdown : jsonb\n  calculated_at : timestamp\n}\nentity USER_PROGRESS {\n  * user_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  * competency_key : varchar &lt;&lt;PK&gt;&gt;\n  --\n  mastery_score : numeric\n  evidence_count : int\n  updated_at : timestamp\n}\n\nSCORING_CONFIG ||--o{ QUESTION_PACKAGE\nQUESTION_PACKAGE ||--|{ PACKAGE_ITEM\nQUESTION_PACKAGE ||--o{ TRYOUT_ATTEMPT\nTRYOUT_ATTEMPT ||--o{ ATTEMPT_ANSWER\nTRYOUT_ATTEMPT ||--o| ATTEMPT_RESULT\nUSER ||--o{ TRYOUT_ATTEMPT\nUSER ||--o{ USER_PROGRESS\nQUESTION_PACKAGE ..&gt; CONTENT_CATEGORY : optional catalog taxonomy\nPACKAGE_ITEM ..&gt; CONTENT_QUESTION_VERSION : exact configured version\n\nnote bottom of QUESTION_PACKAGE\n  category_id is optional catalog metadata for a\n  topic-focused Practice Package. A broad/full Tryout\n  may span sections and leave category_id empty.\nend note\nnote bottom of PACKAGE_ITEM\n  Source of truth for package composition.\n  Content Creator selects exact published Question Versions,\n  fixes their position, and may group them with section_code.\n  Taxonomy metadata never causes random question selection.\nend note\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1650" svgContentHeight="1150" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="portable-font-only" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-18-ff6dcb09cc">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
