        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nhide footbox\nskinparam maxMessageSize 44\nskinparam ParticipantPadding 24\nskinparam BoxPadding 12\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam sequence {\n  ArrowColor #475569\n  LifeLineBorderColor #64748B\n  LifeLineBackgroundColor #F8FAFC\n  ParticipantBorderColor #2563EB\n  ParticipantBackgroundColor #EFF6FF\n  ParticipantFontColor #0F172A\n  ActorBorderColor #0F172A\n  ActorBackgroundColor #FFFFFF\n  ActorFontColor #0F172A\n  GroupBorderColor #94A3B8\n  GroupBackgroundColor #F8FAFC\n  GroupHeaderFontColor #334155\n  DividerBackgroundColor #E2E8F0\n  DividerBorderColor #94A3B8\n}\ntitle Sequence — Approve and Publish a Content Version\nautonumber\nactor \&quot;Content Admin\&quot; as Author\nactor Reviewer\nactor \&quot;Super Admin\&quot; as Admin\nparticipant \&quot;CMS Web\&quot; as Web\nparticipant \&quot;Content API\&quot; as API\ndatabase \&quot;Primary DB\&quot; as DB\nparticipant \&quot;Object Storage\&quot; as Storage\nparticipant \&quot;Cache / CDN\&quot; as CDN\n\nAuthor -&gt; Web : Submit draft version\nWeb -&gt; API : POST /versions/{id}/submit\nAPI -&gt; DB : Validate metadata, assets, scoring, rights\nAPI -&gt; DB : Set IN_REVIEW and create audit event\nAPI --&gt; Web : Submitted\nReviewer -&gt; Web : Open review queue\nWeb -&gt; API : GET version + preview\nAPI -&gt; DB : Load immutable version\nAPI -&gt; Storage : Resolve assets\nStorage --&gt; API : Asset URLs and metadata\nAPI --&gt; Web : Review payload\nalt Changes requested\n  Reviewer -&gt; Web : Add notes and request revision\n  Web -&gt; API : POST /reviews/{id}/changes-requested\n  API -&gt; DB : Set CHANGES_REQUESTED + notes\nelse Approved\n  Reviewer -&gt; Web : Approve version\n  Web -&gt; API : POST /reviews/{id}/approve\n  API -&gt; DB : Set APPROVED\n  Admin -&gt; Web : Publish now / schedule\n  Web -&gt; API : POST /versions/{id}/publish\n  API -&gt; DB : Create publication and set effective_at\n  API -&gt; CDN : Invalidate affected cache keys\n  CDN --&gt; API : Invalidation accepted\n  API -&gt; DB : Set PUBLISHED + audit event\nend\nAPI --&gt; Web : Final workflow status\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1450" svgContentHeight="1140" svgSizingStats="{&quot;participants&quot;:8,&quot;messages&quot;:24,&quot;fragments&quot;:2,&quot;dividers&quot;:0,&quot;notes&quot;:0}" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="sequence-wrap-44" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-15-f227ce1e01">
