  <diagram name="14 · SEQUENCE — PAYMENT CALLBACK" id="PTagvMpCQZ0SRVALFGwL">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2096" pageHeight="1828" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nhide footbox\nskinparam maxMessageSize 44\nskinparam ParticipantPadding 24\nskinparam BoxPadding 12\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam sequence {\n  ArrowColor #475569\n  LifeLineBorderColor #64748B\n  LifeLineBackgroundColor #F8FAFC\n  ParticipantBorderColor #2563EB\n  ParticipantBackgroundColor #EFF6FF\n  ParticipantFontColor #0F172A\n  ActorBorderColor #0F172A\n  ActorBackgroundColor #FFFFFF\n  ActorFontColor #0F172A\n  GroupBorderColor #94A3B8\n  GroupBackgroundColor #F8FAFC\n  GroupHeaderFontColor #334155\n  DividerBackgroundColor #E2E8F0\n  DividerBorderColor #94A3B8\n}\ntitle Sequence — Payment Callback, Cancellation, and State Guard\nautonumber\nactor Learner\nparticipant \&quot;Web App\&quot; as Web\nparticipant \&quot;Billing API\&quot; as Billing\nparticipant \&quot;Payment Gateway\&quot; as Gateway\ndatabase \&quot;Primary DB\&quot; as DB\nparticipant \&quot;Notification Service\&quot; as Notify\n\nLearner -&gt; Web : Confirm checkout\nWeb -&gt; Billing : POST /checkouts\nBilling -&gt; DB : Create PENDING transaction\nBilling -&gt; Gateway : Create payment session\nGateway --&gt; Billing : Redirect URL + gateway reference\nBilling --&gt; Web : Checkout session\nWeb --&gt; Learner : Redirect / show gateway session\nLearner -&gt; Gateway : Open or attempt payment\n\nopt Learner cancels while still PENDING\n  Learner -&gt; Web : Cancel pending payment\n  Web -&gt; Billing : POST /transactions/{reference}/cancel\n  Billing -&gt; DB : Compare-and-set PENDING -&gt; CANCELLED\n  Billing -&gt; Gateway : Cancel session if provider supports it\n  Gateway --&gt; Billing : Cancellation accepted / unavailable\n  Billing --&gt; Web : CANCELLED\n  Web --&gt; Learner : Return to billing / plans\nend\n\nGateway -&gt; Billing : Signed webhook(callback)\nBilling -&gt; Billing : Verify signature, amount, currency,\\ntimestamp and idempotency\nBilling -&gt; DB : Find transaction by unique reference\\nand read current status\nalt PENDING + first valid success\n  Billing -&gt; DB : Mark PAID and activate subscription\\natomically\n  Billing -&gt; Notify : Send invoice / confirmation\n  Notify --&gt; Billing : Accepted\nelse PAID + duplicate success\n  Billing -&gt; DB : Keep existing PAID state; no-op\nelse PENDING + failed / expired\n  Billing -&gt; DB : Record FAILED or EXPIRED\nelse CANCELLED + late gateway event\n  Billing -&gt; DB : Persist payment event and flag\\nreconciliation; do not activate\nend\nBilling --&gt; Gateway : 2xx acknowledgement\nWeb -&gt; Billing : GET /transactions/{reference}\nBilling --&gt; Web : Transaction + entitlement state\nWeb --&gt; Learner : Paid, failed, expired, cancelled,\\nor pending status\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1400" svgContentHeight="1250" svgSizingStats="{&quot;participants&quot;:6,&quot;messages&quot;:20,&quot;fragments&quot;:3,&quot;dividers&quot;:0,&quot;notes&quot;:0}" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="sequence-wrap-44" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-14-8159b9f610">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="1696" width="2016" x="40" y="40" as="geometry" />
