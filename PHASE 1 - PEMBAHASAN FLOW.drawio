  <diagram name="20 · COMPONENT ARCHITECTURE" id="y-cP1-onD4FICqj_SMZL">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2640" pageHeight="1812" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam componentBackgroundColor #EFF6FF\nskinparam componentBorderColor #2563EB\nskinparam componentFontColor #0F172A\nskinparam nodeBackgroundColor #F8FAFC\nskinparam nodeBorderColor #64748B\nskinparam nodeFontColor #0F172A\nskinparam databaseBackgroundColor #ECFDF5\nskinparam databaseBorderColor #16A34A\nskinparam databaseFontColor #064E3B\nskinparam cloudBackgroundColor #FFF7ED\nskinparam cloudBorderColor #F97316\nskinparam queueBackgroundColor #F5F3FF\nskinparam queueBorderColor #7C3AED\nskinparam queueFontColor #4C1D95\nskinparam linetype ortho\ntitle CPNS Mastery \u2014 Logical Component Architecture\nleft to right direction\npackage \&quot;Client Layer\&quot; {\n  [Learner Web App] as LearnerWeb\n  [Admin CMS Web App] as AdminWeb\n}\npackage \&quot;API &amp; Domain Services\&quot; {\n  [API Gateway / BFF] as BFF\n  [Identity Service] as Identity\n  [Content Service] as Content\n  [Assessment Service] as Assessment\n  [Scoring Service] as Scoring\n  [Progress Service] as Progress\n  [Billing Service] as Billing\n  [Notification Service] as Notify\n  [Audit Service] as Audit\n}\ndatabase \&quot;PostgreSQL\&quot; as DB\nqueue \&quot;Task / Event Queue\&quot; as Queue\ncloud \&quot;Object Storage + CDN\&quot; as Storage\ncloud \&quot;Payment Gateway\&quot; as Gateway\ncloud \&quot;Email Provider\&quot; as Email\n\nLearnerWeb --&gt; BFF : HTTPS / JSON\nAdminWeb --&gt; BFF : HTTPS / JSON\nBFF --&gt; Identity\nBFF --&gt; Content\nBFF --&gt; Assessment\nBFF --&gt; Progress\nBFF --&gt; Billing\nAssessment --&gt; Scoring\nContent --&gt; Storage\nAssessment --&gt; Storage\nIdentity --&gt; DB\nContent --&gt; DB\nAssessment --&gt; DB\nScoring --&gt; DB\nProgress --&gt; DB\nBilling --&gt; DB\nAudit --&gt; DB\nAssessment --&gt; Queue : scoring / progress events\nContent --&gt; Queue : publish events\nBilling --&gt; Queue : payment events\nQueue --&gt; Progress\nQueue --&gt; Notify\nQueue --&gt; Audit\nBilling --&gt; Gateway\nNotify --&gt; Email\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="preserve" svgContentWidth="1600" svgContentHeight="1050" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="portable-font-only" fontPolicy="SansSerif-portable" renderPolicy="source-first-wrap;svg-aspect-preserved" id="g-20-a48d608d29">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="1680" width="2560" x="40" y="40" as="geometry" />
