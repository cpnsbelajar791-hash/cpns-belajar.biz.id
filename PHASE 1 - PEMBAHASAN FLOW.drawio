  <diagram name="20 · COMPONENT ARCHITECTURE" id="uGQVNF4OQ53zcsCIkX6x">
    <mxGraphModel dx="1258" dy="1224" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2640" pageHeight="1812" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam componentBackgroundColor #EFF6FF\nskinparam componentBorderColor #2563EB\nskinparam componentFontColor #0F172A\nskinparam nodeBackgroundColor #F8FAFC\nskinparam nodeBorderColor #64748B\nskinparam nodeFontColor #0F172A\nskinparam databaseBackgroundColor #ECFDF5\nskinparam databaseBorderColor #16A34A\nskinparam databaseFontColor #064E3B\nskinparam cloudBackgroundColor #FFF7ED\nskinparam cloudBorderColor #F97316\nskinparam queueBackgroundColor #F5F3FF\nskinparam queueBorderColor #7C3AED\nskinparam queueFontColor #4C1D95\nskinparam linetype ortho\ntitle CPNS Mastery — Logical Component Architecture\nleft to right direction\npackage \&quot;Client Layer\&quot; {\n  [Learner Web App] as LearnerWeb\n  [Admin CMS Web App] as AdminWeb\n}\npackage \&quot;API &amp; Domain Services\&quot; {\n  [API Gateway / BFF] as BFF\n  [Identity Service] as Identity\n  [Content Service] as Content\n  [Assessment Service] as Assessment\n  [Scoring Service] as Scoring\n  [Progress Service] as Progress\n  [Billing Service] as Billing\n  [Notification Service] as Notify\n  [Audit Service] as Audit\n}\ndatabase \&quot;PostgreSQL\&quot; as DB\nqueue \&quot;Task / Event Queue\&quot; as Queue\ncloud \&quot;Object Storage + CDN\&quot; as Storage\ncloud \&quot;Payment Gateway\&quot; as Gateway\ncloud \&quot;Email Provider\&quot; as Email\n\nLearnerWeb --&gt; BFF : HTTPS / JSON\nAdminWeb --&gt; BFF : HTTPS / JSON\nBFF --&gt; Identity\nBFF --&gt; Content\nBFF --&gt; Assessment\nBFF --&gt; Progress\nBFF --&gt; Billing\nAssessment --&gt; Scoring\nContent --&gt; Storage\nAssessment --&gt; Storage\nIdentity --&gt; DB\nContent --&gt; DB\nAssessment --&gt; DB\nScoring --&gt; DB\nProgress --&gt; DB\nBilling --&gt; DB\nAudit --&gt; DB\nAssessment --&gt; Queue : scoring / progress events\nContent --&gt; Queue : publish events\nBilling --&gt; Queue : payment events\nQueue --&gt; Progress\nQueue --&gt; Notify\nQueue --&gt; Audit\nBilling --&gt; Gateway\nNotify --&gt; Email\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1600" svgContentHeight="1050" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="portable-font-only" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-20-a48d608d29">
