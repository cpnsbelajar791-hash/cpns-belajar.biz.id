  <diagram name="04 · USE CASE — COMMERCE &amp; ADMINISTRATION" id="EcAnRMvkOB296VZ22ATK">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2640" pageHeight="1732" background="#FFFFFF" math="0" shadow="0">
      <root>
