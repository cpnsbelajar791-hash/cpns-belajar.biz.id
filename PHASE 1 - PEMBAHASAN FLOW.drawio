attempt_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  --\n  total_score : numeric\n  max_score : numeric\n  competency_breakdown : jsonb\n  calculated_at : timestamp\n}\nentity USER_PROGRESS {\n  * user_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  * competency_key : varchar &lt;&lt;PK&gt;&gt;\n  --\n  mastery_score : numeric\n  evidence_count : int\n  updated_at : timestamp\n}\nentity REMEDIATION_ITEM {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * user_id : UUID &lt;&lt;FK&gt;&gt;\n  * question_id : UUID &lt;&lt;FK&gt;&gt;\n  source_attempt_id : UUID? &lt;&lt;FK&gt;&gt;\n  priority : int\n  next_review_at : timestamp?\n  resolved_at : timestamp?\n}\nSCORING_CONFIG ||--o{ QUESTION_PACKAGE\nQUESTION_PACKAGE ||--|{ PACKAGE_ITEM\nQUESTION_PACKAGE ||--o{ TRYOUT_ATTEMPT\nTRYOUT_ATTEMPT ||--o{ ATTEMPT_ANSWER\nTRYOUT_ATTEMPT ||--o| ATTEMPT_RESULT\nTRYOUT_ATTEMPT ||--o{ REMEDIATION_ITEM : source\nUSER ||--o{ TRYOUT_ATTEMPT\nUSER ||--o{ USER_PROGRESS\nUSER ||--o{ REMEDIATION_ITEM\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1650" svgContentHeight="1150" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="portable-font-only" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-18-ff6dcb09cc">
