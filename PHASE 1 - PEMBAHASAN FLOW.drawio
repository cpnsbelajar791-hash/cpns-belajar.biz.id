        <mxCell id="guide-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#0F172A;" value="CPNS MASTERY — UML &amp; SYSTEM ANALYSIS v0.9" vertex="1">
          <mxGeometry height="70" width="1460" x="70" y="60" as="geometry" />
        </mxCell>
        <mxCell id="guide-sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontColor=#475569;" value="PlantUML SVG edition fixed at the source level: long activity labels, decisions, sequence messages, and use-case names wrap before PlantUML renders them. The SVG is no longer made visually wide by one long sentence." vertex="1">
          <mxGeometry height="50" width="1460" x="70" y="135" as="geometry" />
        </mxCell>
        <mxCell id="guide-left" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontSize=16;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;" value="&lt;b&gt;01&lt;/b&gt; — System Context&lt;br&gt;&lt;b&gt;02&lt;/b&gt; — Use Case — Learner&lt;br&gt;&lt;b&gt;03&lt;/b&gt; — Use Case — Content Management&lt;br&gt;&lt;b&gt;04&lt;/b&gt; — Use Case — Commerce &amp; Administration&lt;br&gt;&lt;b&gt;05&lt;/b&gt; — Activity — Register &amp; Onboarding&lt;br&gt;&lt;b&gt;06&lt;/b&gt; — Activity — Learn Material&lt;br&gt;&lt;b&gt;07&lt;/b&gt; — Activity — Practice Question&lt;br&gt;&lt;b&gt;08&lt;/b&gt; — Activity — Timed Tryout&lt;br&gt;&lt;b&gt;09&lt;/b&gt; — Activity — Review Wrong Answers&lt;br&gt;&lt;b&gt;10&lt;/b&gt; — Activity — Subscription Payment&lt;br&gt;&lt;b&gt;11&lt;/b&gt; — Activity — Review &amp; Publish Content" vertex="1">
          <mxGeometry height="560" width="700" x="80" y="230" as="geometry" />
        </mxCell>
        <mxCell id="guide-right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontSize=16;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;" value="&lt;b&gt;12&lt;/b&gt; — Sequence — Start Tryout&lt;br&gt;&lt;b&gt;13&lt;/b&gt; — Sequence — Autosave &amp; Submit Tryout&lt;br&gt;&lt;b&gt;14&lt;/b&gt; — Sequence — Payment Callback&lt;br&gt;&lt;b&gt;15&lt;/b&gt; — Sequence — Publish Content&lt;br&gt;&lt;b&gt;16&lt;/b&gt; — ERD — Identity &amp; RBAC&lt;br&gt;&lt;b&gt;17&lt;/b&gt; — ERD — Content &amp; Question Bank&lt;br&gt;&lt;b&gt;18&lt;/b&gt; — ERD — Assessment &amp; Progress&lt;br&gt;&lt;b&gt;19&lt;/b&gt; — ERD — Subscription &amp; Payment&lt;br&gt;&lt;b&gt;20&lt;/b&gt; — Component Architecture&lt;br&gt;&lt;b&gt;21&lt;/b&gt; — Google Cloud Deployment&lt;br&gt;&lt;b&gt;22&lt;/b&gt; — State — Content Lifecycle" vertex="1">
          <mxGeometry height="560" width="700" x="820" y="230" as="geometry" />
        </mxCell>
        <mxCell id="guide-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fontSize=15;fillColor=#FFF7ED;strokeColor=#F97316;fontColor=#7C2D12;" value="&lt;b&gt;Universal rule:&lt;/b&gt; control width in PlantUML source—not by stretching or guessing the Draw.io image box. Activity labels use MaximumWidth + explicit line wrapping; sequence messages use maxMessageSize; SVG aspect ratio remains locked." vertex="1">
          <mxGeometry height="90" width="1440" x="80" y="825" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
