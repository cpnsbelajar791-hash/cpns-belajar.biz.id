        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nhide circle\nhide methods\nskinparam classAttributeIconSize 0\nskinparam classBackgroundColor #F8FAFC\nskinparam classBorderColor #2563EB\nskinparam classFontColor #0F172A\nskinparam classHeaderBackgroundColor #DBEAFE\nskinparam classHeaderFontColor #0F172A\nskinparam linetype ortho\ntitle ERD — Learning Content and Question Bank\nentity MATERIAL {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * exam_type : enum\n  * category_id : UUID &lt;&lt;FK&gt;&gt;\n  slug : varchar &lt;&lt;UQ&gt;&gt;\n  access_tier : enum\n}\nentity MATERIAL_VERSION {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * material_id : UUID &lt;&lt;FK&gt;&gt;\n  * version_no : int\n  title : varchar\n  learning_objective : text\n  status : enum\n  effective_at : timestamp?\n}\nentity MATERIAL_SECTION {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * material_version_id : UUID &lt;&lt;FK&gt;&gt;\n  * position : int\n  section_type : enum\n  content : jsonb\n}\nentity CATEGORY {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  parent_id : UUID? &lt;&lt;FK&gt;&gt;\n  exam_type : enum\n  name : varchar\n}\nentity QUESTION {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * category_id : UUID &lt;&lt;FK&gt;&gt;\n  question_type : enum\n  difficulty : enum\n  access_tier : enum\n}\nentity QUESTION_VERSION {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * question_id : UUID &lt;&lt;FK&gt;&gt;\n  * version_no : int\n  stem : text\n  explanation : text\n  scoring_model : enum\n  status : enum\n}\nentity QUESTION_OPTION {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * question_version_id : UUID &lt;&lt;FK&gt;&gt;\n  * position : int\n  label : varchar\n  content : text\n  score_value : numeric?\n  is_correct : boolean?\n}\nentity ASSET {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  storage_key : varchar &lt;&lt;UQ&gt;&gt;\n  mime_type : varchar\n  width_px : int?\n  height_px : int?\n  checksum : varchar\n  rights_status : enum\n  source_page : int?\n  crop_parent_id : UUID? &lt;&lt;FK&gt;&gt;\n}\nentity MATERIAL_ASSET {\n  * material_version_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  * asset_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  purpose : enum\n}\nentity QUESTION_ASSET {\n  * question_version_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  * asset_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  purpose : enum\n  position : int\n}\nCATEGORY ||--o{ CATEGORY : parent\nCATEGORY ||--o{ MATERIAL\nMATERIAL ||--o{ MATERIAL_VERSION\nMATERIAL_VERSION ||--o{ MATERIAL_SECTION\nCATEGORY ||--o{ QUESTION\nQUESTION ||--o{ QUESTION_VERSION\nQUESTION_VERSION ||--|{ QUESTION_OPTION\nMATERIAL_VERSION ||--o{ MATERIAL_ASSET\nASSET ||--o{ MATERIAL_ASSET\nQUESTION_VERSION ||--o{ QUESTION_ASSET\nASSET ||--o{ QUESTION_ASSET\nASSET |o--o{ ASSET : crop source\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1700" svgContentHeight="1200" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="portable-font-only" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-17-f76d8f3a9d">
