  <diagram name="15 · SEQUENCE — PUBLISH CONTENT" id="tw6wmlPQJp3xRswh7ZTX">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2400" pageHeight="1956" background="#FFFFFF" math="0" shadow="0">
      <root>
