  <diagram name="16 · ERD — IDENTITY &amp; RBAC" id="1BLQDZ7a3jhkFOZPBTHl">
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2480" pageHeight="1812" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nhide circle\nhide methods\nskinparam classAttributeIconSize 0\nskinparam classBackgroundColor #F8FAFC\nskinparam classBorderColor #2563EB\nskinparam classFontColor #0F172A\nskinparam classHeaderBackgroundColor #DBEAFE\nskinparam classHeaderFontColor #0F172A\nskinparam linetype ortho\ntitle ERD \u2014 Identity, Profile, and Role-based Access\nentity USER {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * email : varchar &lt;&lt;UQ&gt;&gt;\n  * password_hash : varchar\n  * email_verified_at : timestamp?\n  * status : enum\n  * created_at : timestamp\n}\nentity PROFILE {\n  * user_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  --\n  display_name : varchar\n  target_exam : varchar?\n  study_preference : jsonb?\n  onboarding_completed_at : timestamp?\n}\nentity ROLE {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * code : varchar &lt;&lt;UQ&gt;&gt;\n  name : varchar\n}\nentity PERMISSION {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * code : varchar &lt;&lt;UQ&gt;&gt;\n  module : varchar\n  action : varchar\n}\nentity USER_ROLE {\n  * user_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  * role_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  --\n  scope : jsonb?\n  granted_at : timestamp\n}\nentity ROLE_PERMISSION {\n  * role_id : UUID &lt;&lt;PK,FK&gt;&gt;\n  * permission_id : UUID &lt;&lt;PK,FK&gt;&gt;\n}\nentity SESSION {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  * user_id : UUID &lt;&lt;FK&gt;&gt;\n  token_hash : varchar\n  expires_at : timestamp\n  revoked_at : timestamp?\n}\nentity AUDIT_LOG {\n  * id : UUID &lt;&lt;PK&gt;&gt;\n  --\n  actor_user_id : UUID? &lt;&lt;FK&gt;&gt;\n  action : varchar\n  resource_type : varchar\n  resource_id : UUID?\n  payload : jsonb\n  created_at : timestamp\n}\nUSER ||--|| PROFILE\nUSER ||--o{ USER_ROLE\nROLE ||--o{ USER_ROLE\nROLE ||--o{ ROLE_PERMISSION\nPERMISSION ||--o{ ROLE_PERMISSION\nUSER ||--o{ SESSION\nUSER |o--o{ AUDIT_LOG : actor\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="preserve" svgContentWidth="1500" svgContentHeight="1050" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="portable-font-only" fontPolicy="SansSerif-portable" renderPolicy="source-first-wrap;svg-aspect-preserved" id="g-16-160e89fb7c">
