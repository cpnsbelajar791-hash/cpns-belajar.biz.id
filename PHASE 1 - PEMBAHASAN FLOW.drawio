        </mxCell>
        <mxCell id="guide-right" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontSize=16;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;" value="&lt;b&gt;12&lt;/b&gt; — Sequence — Start Tryout&lt;br&gt;&lt;b&gt;13&lt;/b&gt; — Sequence — Autosave &amp; Submit Tryout&lt;br&gt;&lt;b&gt;14&lt;/b&gt; — Sequence — Payment Callback&lt;br&gt;&lt;b&gt;15&lt;/b&gt; — Sequence — Publish Content&lt;br&gt;&lt;b&gt;16&lt;/b&gt; — ERD — Identity &amp; RBAC&lt;br&gt;&lt;b&gt;17&lt;/b&gt; — ERD — Content &amp; Question Bank&lt;br&gt;&lt;b&gt;18&lt;/b&gt; — ERD — Assessment &amp; Progress&lt;br&gt;&lt;b&gt;19&lt;/b&gt; — ERD — Subscription &amp; Payment&lt;br&gt;&lt;b&gt;20&lt;/b&gt; — Component Architecture&lt;br&gt;&lt;b&gt;21&lt;/b&gt; — Google Cloud Deployment&lt;br&gt;&lt;b&gt;22&lt;/b&gt; — State — Content Lifecycle" vertex="1">
          <mxGeometry height="560" width="700" x="820" y="230" as="geometry" />
