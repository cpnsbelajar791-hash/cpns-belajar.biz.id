  <diagram name="11 · ACTIVITY — REVIEW &amp; PUBLISH CONTENT" id="4ISi8zWVTpQPgbSbfFZf">
    <mxGraphModel dx="2012" dy="1318" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1840" pageHeight="2612" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam preserveAspectRatio xMidYMid meet\nskinparam svgDimensionStyle false\nskinparam wrapWidth 180\n&lt;style&gt;\nActivityDiagram {\n  MaximumWidth 240\n}\n&lt;/style&gt;\nskinparam backgroundColor #FFFFFF\nskinparam shadowing false\nskinparam roundcorner 14\nskinparam defaultFontName SansSerif\nskinparam defaultFontSize 14\nskinparam ArrowColor #475569\nskinparam ArrowThickness 1.2\nskinparam TitleFontColor #0F172A\nskinparam TitleFontSize 22\nskinparam NoteBackgroundColor #FFF7ED\nskinparam NoteBorderColor #F97316\nskinparam NoteFontColor #7C2D12\nskinparam activityBackgroundColor #EFF6FF\nskinparam activityBorderColor #2563EB\nskinparam activityFontColor #0F172A\nskinparam activityDiamondBackgroundColor #FFF7ED\nskinparam activityDiamondBorderColor #F97316\nskinparam activityStartColor #16A34A\nskinparam activityEndColor #DC2626\nskinparam partitionBackgroundColor #F8FAFC\nskinparam partitionBorderColor #CBD5E1\nskinparam partitionFontColor #334155\ntitle Activity — Content Review, Approval, and Publication\n|Content Admin|\nstart\n:Complete material or question\\ndraft;\n:Submit version for review;\n|CMS|\n:Validate required metadata,\\nassets, and scoring;\nif (Validation passed?) then (yes)\n  :Set status IN_REVIEW;\nelse (no)\n  :Return validation errors;\n  stop\nendif\n|Reviewer|\n:Inspect content, source\\nrights, answer, and\\nexplanation;\nif (Revision required?) then (yes)\n  :Add actionable review notes;\n  |CMS|\n  :Set status CHANGES_REQUESTED;\n  |Content Admin|\n  :Revise version and resubmit;\n  stop\nelse (approved)\n  :Approve immutable version;\nendif\n|CMS|\n:Set status APPROVED;\n|Super Admin|\n:Choose publish now or schedule;\n|CMS|\n:Run final publication checks;\n:Create publication record and\\neffective date;\n|Database|\n:Persist published version and\\naudit log;\n|Cache / CDN|\n:Invalidate affected content\\ncache;\n|CMS|\n:Set status PUBLISHED;\nstop\n@enduml\n&quot;,&quot;config&quot;:null}" svgSizingMode="content-driven-auto-fit" svgAspectPolicy="root-preserveAspectRatio-xMidYMid-meet" svgContentWidth="1100" svgContentHeight="1550" svgDisplayMode="infinite-canvas" svgUniformScale="1.6" recommendedZoomMode="100%-or-fit-width" sourceWidthPolicy="activity-wrap-30" fontPolicy="SansSerif-portable" renderPolicy="plantuml-svg-root-aspect-safe" svgDimensionPolicy="viewBox-only-no-fixed-width-height" id="g-11-9c25c57d6d">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="2480" width="1760" x="40" y="40" as="geometry" />
