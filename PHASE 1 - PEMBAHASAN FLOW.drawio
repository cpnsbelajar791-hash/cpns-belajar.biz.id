        <mxCell id="note-16" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#64748B;" value="Revision 01 — User Profiling + CPNS target master data; no NIK/KK/full-address collection; agency/formasi remain optional during onboarding." vertex="1">
